      <g fill="{% if v == 'room-off' %}#4a4239{% else %}#22202a{% endif %}">
        <rect x="360" y="600" width="660" height="170" rx="40"/>
        <rect x="320" y="560" width="110" height="230" rx="40"/>
        <rect x="950" y="560" width="110" height="230" rx="40"/>
