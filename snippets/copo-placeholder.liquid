{%- comment -%}
  Ilustración provisional (no es una foto del producto).
  variant: 'room-off' | 'room-on' | 'product' | 'category'
  label: texto que aparece en la etiqueta "Provisional". Se muestra siempre,
  para que nadie confunda la ilustración con el resultado real del producto.
{%- endcomment -%}
{%- assign v = variant | default: 'room-on' -%}
<div class="copo-ph copo-ph--{{ v }}" role="img" aria-label="{{ label | default: 'Imagen provisional' | escape }}">
  <svg viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="copoWall-{{ v }}" x1="0" y1="0" x2="0" y2="1">
        {%- if v == 'room-off' -%}
          <stop offset="0" stop-color="#3a3630"/><stop offset="1" stop-color="#25221e"/>
        {%- elsif v == 'product' or v == 'category' -%}
          <stop offset="0" stop-color="#F1E8DA"/><stop offset="1" stop-color="#E4D6BF"/>
        {%- else -%}
          <stop offset="0" stop-color="#0d1020"/><stop offset=".6" stop-color="#161a2b"/><stop offset="1" stop-color="#1d1a1c"/>
        {%- endif -%}
      </linearGradient>
      <radialGradient id="copoGlow-{{ v }}" cx=".5" cy=".85" r=".7">
        <stop offset="0" stop-color="#F6C978" stop-opacity="{% if v == 'room-off' %}.35{% else %}.22{% endif %}"/>
        <stop offset="1" stop-color="#F6C978" stop-opacity="0"/>
      </radialGradient>
      <filter id="copoBlur-{{ v }}" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2.2"/></filter>
      <g id="copoFlake-{{ v }}" stroke="#FFF1D2" stroke-width="1.4" stroke-linecap="round" fill="none" opacity=".75"><path d="M0-20V20M-17.3-10L17.3 10M-17.3 10L17.3-10"/></g>
    </defs>
    <rect width="1600" height="1000" fill="url(#copoWall-{{ v }})"/>
    {%- if v == 'product' or v == 'category' -%}
      <ellipse cx="800" cy="760" rx="420" ry="46" fill="#14161C" opacity=".12"/>
      <path d="M640 760c0-120 72-232 160-232s160 112 160 232z" fill="#1F2B26"/>
      <ellipse cx="800" cy="560" rx="60" ry="22" fill="#D8B477"/>
      <circle cx="800" cy="556" r="10" fill="#FBF8F2"/>
    {%- else -%}
      <rect y="720" width="1600" height="280" fill="{% if v == 'room-off' %}#2e2a25{% else %}#141318{% endif %}"/>
      <rect width="1600" height="1000" fill="url(#copoGlow-{{ v }})"/>
      {%- if v == 'room-on' -%}
        <g filter="url(#copoBlur-{{ v }})"><circle cx="525" cy="67" r="1.6" fill="#FFE9B8" opacity="0.9"/><circle cx="590" cy="27" r="1.6" fill="#FFFFFF" opacity="0.5"/><circle cx="129" cy="35" r="3.6" fill="#FFF6E0" opacity="0.52"/><circle cx="1004" cy="120" r="3.6" fill="#FFF6E0" opacity="0.67"/><circle cx="93" cy="241" r="2" fill="#F6D58E" opacity="0.75"/><circle cx="894" cy="149" r="3.6" fill="#F6D58E" opacity="0.8"/><circle cx="172" cy="268" r="3.6" fill="#FFFFFF" opacity="0.56"/><circle cx="1232" cy="235" r="2.4" fill="#FFF6E0" opacity="0.61"/><circle cx="1110" cy="97" r="3.6" fill="#F6D58E" opacity="0.72"/><circle cx="1158" cy="155" r="1.6" fill="#FFF6E0" opacity="0.73"/><circle cx="1201" cy="58" r="1.6" fill="#FFE9B8" opacity="0.98"/><circle cx="1213" cy="278" r="2.4" fill="#F6D58E" opacity="0.64"/><circle cx="947" cy="198" r="1.6" fill="#FFFFFF" opacity="0.97"/><circle cx="1107" cy="36" r="2.4" fill="#FFFFFF" opacity="0.81"/><circle cx="464" cy="162" r="1.6" fill="#F6D58E" opacity="0.97"/><circle cx="282" cy="27" r="2.4" fill="#FFF6E0" opacity="0.52"/><circle cx="641" cy="321" r="2" fill="#F6D58E" opacity="0.7"/><circle cx="1398" cy="390" r="2.4" fill="#F6D58E" opacity="0.84"/><circle cx="1085" cy="102" r="1.6" fill="#FFF6E0" opacity="0.55"/><circle cx="1047" cy="14" r="2" fill="#FFE9B8" opacity="0.59"/><circle cx="247" cy="211" r="2.4" fill="#FFE9B8" opacity="0.97"/><circle cx="732" cy="440" r="4.6" fill="#FFFFFF" opacity="0.89"/><circle cx="641" cy="140" r="3" fill="#FFE9B8" opacity="0.48"/><circle cx="1556" cy="99" r="3.6" fill="#FFE9B8" opacity="0.48"/><circle cx="904" cy="274" r="3.6" fill="#FFF6E0" opacity="0.46"/><circle cx="978" cy="44" r="2.4" fill="#FFFFFF" opacity="0.78"/><circle cx="212" cy="441" r="3" fill="#F6D58E" opacity="0.71"/><circle cx="154" cy="36" r="2.4" fill="#FFF6E0" opacity="0.71"/><circle cx="825" cy="111" r="2.4" fill="#FFE9B8" opacity="0.53"/><circle cx="1203" cy="124" r="1.6" fill="#F6D58E" opacity="0.83"/><circle cx="829" cy="