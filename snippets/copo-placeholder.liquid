        <g><use href="#copoFlake-{{ v }}" transform="translate(117 59) scale(0.63)"/><use href="#copoFlake-{{ v }}" transform="translate(1041 261) scale(0.84)"/><use href="#copoFlake-{{ v }}" transform="translate(507 205) scale(0.73)"/><use href="#copoFlake-{{ v }}" transform="translate(753 78) scale(0.95)"/><use href="#copoFlake-{{ v }}" transform="translate(379 353) scale(0.97)"/><use href="#copoFlake-{{ v }}" transform="translate(125 187) scale(0.91)"/><use href="#copoFlake-{{ v }}" transform="translate(1455 184) scale(0.63)"/><use href="#copoFlake-{{ v }}" transform="translate(394 343) scale(0.61)"/><use href="#copoFlake-{{ v }}" transform="translate(914 85) scale(0.76)"/></g>
