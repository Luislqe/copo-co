{%- comment -%}
  Iconos de línea Copo & Co. (24×24, trazo 1.5, esquinas redondeadas).
  Uso: {% render 'copo-icon', icon: 'gift', class: 'copo-icon--lg' %}
  Disponibles: star, sparkle, snowflake, plug, timer, gift, truck, shield, return,
  lock, home, bulb, box, chat, moon, check, ruler, leaf
{%- endcomment -%}
{%- capture paths -%}
  {%- case icon -%}
    {%- when 'star' -%}<path d="M12 3.5l2.6 5.3 5.9.9-4.25 4.1 1 5.8L12 16.9l-5.25 2.7 1-5.8L3.5 9.7l5.9-.9L12 3.5z"/>
    {%- when 'sparkle' -%}<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6.3 6.3l2.2 2.2M15.5 15.5l2.2 2.2M6.3 17.7l2.2-2.2M15.5 8.5l2.2-2.2"/><circle cx="12" cy="12" r="1.6"/>
    {%- when 'snowflake' -%}<path d="M12 2.5v19M3.8 7.25l16.4 9.5M3.8 16.75l16.4-9.5M9.5 4.5L12 7l2.5-2.5M9.5 19.5L12 17l2.5 2.5M4.2 10.6l3.4.9-.9 3.4M19.8 13.4l-3.4-.9.9-3.4M4.2 13.4l3.4-.9-.9-3.4M19.8 10.6l-3.4.9.9 3.4"/>
    {%- when 'plug' -%}<path d="M9 3v4.5M15 3v4.5M6.5 7.5h11v3a5.5 5.5 0 01-11 0v-3zM12 16v5"/>
    {%- when 'timer' -%}<circle cx="12" cy="13.5" r="7"/><path d="M12 10v3.5l2.5 1.5M10 3h4M18.5 6.5l1.5-1.5"/>
    {%- when 'gift' -%}<path d="M4 10h16v10H4zM3 7h18v3H3zM12 7v13M12 7c-1.5-3.5-5.5-3.5-5.5-1.3C6.5 7 9 7 12 7zm0 0c1.5-3.5 5.5-3.5 5.5-1.3C17.5 7 15 7 12 7z"/>
    {%- when 'truck' -%}<path d="M3 6.5h11v9H3zM14 9.5h3.5l3 3.2v2.8H14z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'shield' -%}<path d="M12 3l7.5 3v5.5c0 4.5-3.2 8.2-7.5 9.5-4.3-1.3-7.5-5-7.5-9.5V6L12 3z"/><path d="M8.8 12.2l2.2 2.2 4.2-4.4"/>
    {%- when 'return' -%}<path d="M8 8.5H15a5 5 0 010 10H8"/><path d="M11 5.5l-3 3 3 3"/>
    {%- when 'lock' -%}<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 018 0v2.5M12 14.5v2.5"/>
    {%- when 'home' -%}<path d="M4 11l8-6.5 8 6.5M6 9.5V20h12V9.5M10 20v-5h4v5"/>
    {%- when 'bulb' -%}<path d="M9 17.5h6M10 21h4M12 3a6 6 0 00-3.5 10.9c.6.5 1 1.2 1 2V17h5v-1.1c0-.8.4-1.5 1-2A6 6 0 0012 3z"/>
    {%- when 'box' -%}<path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5v-9zM3.5 7.5L12 12l8.5-4.5M12 12v9"/>
    {%- when 'chat' -%}<path d="M4 5.5h16v10H9l-4.5 4v-4H4z"/><path d="M8 10.5h.01M12 10.5h.01M16 10.5h.01"/>
    {%- when 'moon' -%}<path d="M19.5 14.5A8 8 0 019.5 4.5a8 8 0 1010 10z"/>
    {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'ruler' -%}<path d="M3.5 16.5l13-13 4 4-13 13z"/><path d="M7 13l2 2M10 10l2 2M13 7l2 2"/>
    {%- when 'leaf' -%}<path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14zM5 19l7-7"/>
    {%- else -%}<circle cx="12" cy="12" r="1.6"/>
  {%- endcase -%}
{%- endcapture -%}
<svg class="copo-icon {{ class }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ paths }}</svg>
