{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h1'
-%}
<section
  id="CopoHero-{{ section.id }}"
  class="copo-hero copo-hero--{{ section.settings.height }} copo-hero--align-{{ section.settings.alignment }} color-{{ section.settings.color_scheme }}"
  style="--copo-overlay: {{ section.settings.overlay | divided_by: 100.0 }};"
>
  <div class="copo-hero__media">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'metadata',
          image_size: '1920x'
      }}
    {%- elsif section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
            sizes="100vw"
          >
        {%- endif -%}
        {{
          section.settings.image
          | image_url: width: 3000
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1920, 2400, 3000',
            alt: section.settings.image.alt
        }}
      </picture>
    {%- else -%}
      {% render 'copo-placeholder', variant: 'room-on', label: 'Imagen provisional · sube aquí tu foto o vídeo real' %}
    {%- endif -%}
  </div>

  <div class="copo-hero__inner page-width">
    <div class="copo-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="copo-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="copo-hero__heading h0">{{ section.settings.heading }}</{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="copo-hero__text">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="copo-hero__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}" class="button button--primary">
            {{- section.settings.button_label_1 | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: routes.collections_url }}" class="button button--secondary">
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="copo-chips" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- render 'copo-icon', icon: block.settings.icon -%}
              {{ block.settings.text | escape }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Copo · Portada principal",
  "tag": "div",
  "class": "section copo-hero-section",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Fondo" },
    { "type": "video", "id": "video", "label": "Vídeo de fondo (opcional)", "info": "Vídeo corto y silencioso, sin texto. Tiene prioridad sobre la imagen." },
    { "type": "image_picker", "id": "image", "label": "Imagen (escritorio)", "info": "Recomendado 2400×1400 px. Salón real con la iluminación encendida." },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagen (móvil, opcional)", "info": "Formato vertical 1100×1500 px." },
    { "type": "range", "id": "overlay", "label": "Oscurecer imagen", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55 },
    { "type": "select", "id": "height", "label": "Altura", "default": "large", "options": [
      { "value": "medium", "label": "Media" },
      { "value": "large", "label": "Grande" },
      { "value": "full", "label": "Pantalla completa" }
    ] },
    { "type": "select", "id": "alignment", "label": "Alineación del texto", "default": "left", "options": [
      { "value": "left", "label": "Izquierda" },
      { "value": "center", "label": "Centro" }
    ] },
    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Navidad 2026" },
    { "type": "inline_richtext", "id": "heading", "label": "Titular", "info": "Usa cursiva para resaltar una palabra en dorado.", "default": "La Navidad empieza <em>en casa</em>" },
    { "type": "select", "id": "heading_tag", "label": "Etiqueta del titular (SEO)", "default": "h1", "info": "Usa H1 solo en la portada.", "options": [
      { "value": "h1", "label": "H1" },
      { "value": "h2", "label": "H2" }
    ] },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Luces, proyectores y detalles para convertir cualquier habitación en un rincón acogedor estas fiestas." },
    { "type": "text", "id": "button_label_1", "label": "Botón principal", "default": "Descubrir la colección" },
    { "type": "url", "id": "button_link_1", "label": "Enlace del botón principal" },
    { "type": "text", "id": "button_label_2", "label": "Botón secundario", "default": "Ver el proyector" },
    { "type": "url", "id": "button_link_2", "label": "Enlace del botón secundario" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-3" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Garantía corta",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "default": "shield", "options": [{"value": "star", "label": "Estrella"}, {"value": "sparkle", "label": "Destello"}, {"value": "snowflake", "label": "Copo de nieve"}, {"value": "plug", "label": "Enchufe"}, {"value": "timer", "label": "Temporizador"}, {"value": "gift", "label": "Regalo"}, {"value": "truck", "label": "Envío"}, {"value": "shield", "label": "Escudo"}, {"value": "return", "label": "Devolución"}, {"value": "lock", "label": "Candado"}, {"value": "home", "label": "Casa"}, {"value": "bulb", "label": "Bombilla"}, {"value": "box", "label": "Caja"}, {"value": "chat", "label": "Mensaje"}, {"value": "moon", "label": "Luna"}, {"value": "check", "label": "Check"}, {"value": "ruler", "label": "Medidas"}, {"value": "leaf", "label": "Hoja"}] },
        { "type": "text", "id": "text", "label": "Texto", "default": "Pago seguro", "info": "Solo afirmaciones verificables." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Copo · Portada principal",
      "blocks": [
        { "type": "chip", "settings": { "icon": "lock", "text": "Pago seguro" } },
        { "type": "chip", "settings": { "icon": "return", "text": "14 días para desistir" } }
      ]
    }
  ]
}
{% endschema %}
